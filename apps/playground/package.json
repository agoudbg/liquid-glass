{
  "name": "@agou/liquid-glass-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.vue.json --noEmit && tsc -p tsconfig.react.json --noEmit && tsc -p tsconfig.solid.json --noEmit",
    "lint": "eslint src test vite.config.ts vitest.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@agou/liquid-glass-core": "workspace:*",
    "@agou/liquid-glass-vue": "workspace:*",
    "@agou/liquid-glass-react": "workspace:*",
    "@agou/liquid-glass-solid": "workspace:*",
    "vue": "3.5.34",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "6.4.2",
    "vite-plugin-solid": "2.11.12",
    "vitest": "3.2.7",
    "vue-tsc": "2.2.12"
  }
}
