{
  "name": "liquid-glass",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "pnpm --filter @agou/liquid-glass-playground dev",
    "build": "pnpm --recursive --filter=!liquid-glass run build",
    "typecheck": "pnpm --recursive --filter=!liquid-glass run typecheck",
    "lint:root": "eslint eslint.config.ts vitest.workspace.ts playwright.config.ts scripts tests/browser tests/consumers tests/runtime",
    "lint": "pnpm lint:root && pnpm --recursive --filter=!liquid-glass run lint",
    "test": "pnpm test:unit",
    "test:unit": "pnpm --recursive --filter=!liquid-glass run test",
    "test:legacy:tooling": "node --test scripts/legacy/*.test.mjs && pwsh -NoProfile -File scripts/legacy/legacy-capture-helpers.smoke.ps1 && pwsh -NoProfile -File scripts/legacy/test-legacy-capture-validation.ps1",
    "test:legacy:promotion": "pwsh -NoProfile -File scripts/legacy/test-legacy-promotion-transaction.ps1",
    "test:browser": "playwright test --config playwright.config.ts --project=chrome --workers=1",
    "test:visual:preflight": "playwright test --config playwright.config.ts --project=visual-preflight --workers=1",
    "test:visual:exact": "playwright test --config playwright.config.ts --project=visual-dpr-1 --project=visual-dpr-2 --workers=1",
    "test:visual": "pnpm test:visual:exact",
    "test:consumers": "node scripts/test-packed-consumers.mjs",
    "test:performance": "node scripts/test-runtime-acceptance.mjs --performance",
    "test:stability": "node scripts/test-runtime-acceptance.mjs --stability",
    "test:runtime": "node scripts/test-runtime-acceptance.mjs",
    "pack:check": "node scripts/test-packed-consumers.mjs --pack-only",
    "test:watch": "pnpm --parallel --recursive --filter=!liquid-glass run test:watch",
    "verify:workspace": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:legacy:tooling && pnpm build && node scripts/test-packed-consumers.mjs --skip-build && pnpm test:browser",
    "verify": "pnpm verify:workspace && pnpm test:visual && node scripts/test-runtime-acceptance.mjs --skip-candidate-build",
    "ci": "pnpm verify:workspace && pnpm test:visual:preflight && node scripts/test-runtime-acceptance.mjs --skip-candidate-build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.62.0-alpha-1783623505000",
    "@types/node": "22.20.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-solid": "0.14.5",
    "eslint-plugin-vue": "10.9.2",
    "globals": "16.5.0",
    "jiti": "2.7.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.59.2",
    "vitest": "3.2.7",
    "vue-eslint-parser": "10.4.1"
  },
  "engines": {
    "node": ">=22.22.0 <23",
    "pnpm": ">=10.32.0 <11"
  },
  "patchedDependencies": {
    "@eslint/eslintrc@3.3.5": "patches/@eslint__eslintrc@3.3.5.patch"
  }
}
