{
  "name": "@agou/liquid-glass-core",
  "version": "1.0.0-alpha.0",
  "description": "Framework-agnostic WebGL2 liquid glass rendering engine",
  "type": "module",
  "license": "MIT",
  "author": "agou",
  "repository": {
    "type": "git",
    "url": "https://github.com/agoudbg/liquid-glass.git"
  },
  "keywords": [
    "webgl2",
    "glass",
    "refraction",
    "shader",
    "liquid-glass",
    "ui-effect"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test vite.config.ts vitest.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "html-to-image": "1.11.13",
    "html2canvas": "1.4.1"
  },
  "devDependencies": {
    "@types/web": "0.0.150",
    "typescript": "5.6.3",
    "vite": "6.4.2",
    "vite-plugin-dts": "4.5.4",
    "vitest": "3.2.7"
  },
  "peerDependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
