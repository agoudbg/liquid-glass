{
  "name": "@agou/liquid-glass-react",
  "version": "1.0.0-alpha.0",
  "description": "React 19 adapter for @agou/liquid-glass-core",
  "type": "module",
  "license": "MIT",
  "author": "agou",
  "repository": {
    "type": "git",
    "url": "https://github.com/agoudbg/liquid-glass.git"
  },
  "keywords": [
    "react",
    "glass",
    "refraction",
    "liquid-glass",
    "webgl2",
    "ui-effect"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/liquid-glass-react.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/liquid-glass-react.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test vite.config.ts vitest.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@agou/liquid-glass-core": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "25.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.6.3",
    "vite": "6.4.2",
    "vite-plugin-dts": "4.5.4",
    "vitest": "3.2.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
