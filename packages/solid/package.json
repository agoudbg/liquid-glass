{
  "name": "@agou/liquid-glass-solid",
  "version": "0.1.0",
  "description": "Solid adapter for @agou/liquid-glass-core",
  "type": "module",
  "license": "MIT",
  "author": "agou",
  "repository": {
    "type": "git",
    "url": "https://github.com/agoudbg/liquid-glass.git"
  },
  "keywords": [
    "solid",
    "glass",
    "refraction",
    "liquid-glass",
    "webgl2",
    "ui-effect"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/liquid-glass-solid.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "node": "./dist/ssr.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/liquid-glass-solid.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:ssr",
    "build:client": "vite build",
    "build:ssr": "vite build --mode ssr",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test vite.config.ts vitest.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@agou/liquid-glass-core": "workspace:^"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "jsdom": "25.0.1",
    "solid-js": "1.9.12",
    "typescript": "5.6.3",
    "vite": "6.4.2",
    "vite-plugin-dts": "4.5.4",
    "vite-plugin-solid": "2.11.12",
    "vitest": "3.2.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
