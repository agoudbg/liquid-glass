{
  "name": "@agou/liquid-glass-vue",
  "version": "1.0.0-alpha.0",
  "description": "Vue 3 adapter for @agou/liquid-glass-core",
  "type": "module",
  "license": "MIT",
  "author": "agou",
  "repository": {
    "type": "git",
    "url": "https://github.com/agoudbg/liquid-glass.git"
  },
  "keywords": [
    "vue",
    "glass",
    "refraction",
    "liquid-glass",
    "webgl2",
    "ui-effect"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/liquid-glass-vue.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/liquid-glass-vue.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test vite.config.ts vitest.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@agou/liquid-glass-core": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.10",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "6.4.2",
    "vite-plugin-dts": "4.5.4",
    "vitest": "3.2.7",
    "vue": "3.5.34",
    "vue-tsc": "2.2.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
